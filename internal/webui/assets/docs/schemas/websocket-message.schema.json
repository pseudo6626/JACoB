{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacob.local/schemas/v1/websocket-message.schema.json",
  "title": "JACoB WebSocket Message",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "id", "method"],
      "properties": {
        "type": {"const": "request"},
        "id": {"type": "string"},
        "method": {
          "enum": [
            "core.ping", "state.get", "system.health",
            "appearance.get", "appearance.save", "appearance.reset",
            "tabs.list", "tabs.get", "tabs.save", "tabs.delete",
            "bindings.list", "bindings.diagnostics", "bindings.autofill", "bindings.reload", "bindings.get",
            "binding.press", "binding.hold",
            "input.tap", "input.hold", "input.text",
            "recorder.status", "recorder.start", "recorder.stop",
            "video.info",
            "overlay.info", "overlay.set", "overlay.clear"
          ]
        },
        "params": {"type": "object"}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type", "id", "ok"],
      "properties": {
        "type": {"const": "response"},
        "id": {"type": "string"},
        "ok": {"type": "boolean"},
        "result": {},
        "error": {
          "type": "object",
          "properties": {
            "code": {"type":"string"},
            "message": {"type":"string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type", "event"],
      "properties": {
        "type": {"const": "event"},
        "event": {
          "enum": [
            "core.hello", "core.journalFile", "state", "status", "journal",
            "tabs.changed", "appearance.changed", "recorder.input"
          ]
        },
        "data": {}
      },
      "additionalProperties": true
    }
  ]
}
