#!/usr/bin/env bash
set -Eeuo pipefail

ELITE_APP_ID="359320"
HOST_HOME="${JACOB_HOST_HOME:-$(flatpak-spawn --host sh -lc 'printf %s "$HOME"')}"
[[ -n "$HOST_HOME" ]] || exit 1
HOST_DIR="$HOST_HOME/.local/share/JACoB"
HOST_BIN="$HOST_DIR/JACoB"
LAUNCHER="$HOST_DIR/jacob-elite-launch"
HOOK_STAMP="$HOST_DIR/.steam-hook-v4"
LOG_DIR="$HOST_HOME/.config/JACoB"
LOG_FILE="$LOG_DIR/deck-install.log"
mkdir -p "$HOST_DIR" "$LOG_DIR"
exec >>"$LOG_FILE" 2>&1

echo "[$(date -Is)] Steam integration check"

find_steam_root() {
  local p
  for p in "$HOST_HOME/.local/share/Steam" "$HOST_HOME/.steam/steam" "$HOST_HOME/.steam/root"; do
    [[ -d "$p/userdata" ]] && { (cd "$p" && pwd -P); return 0; }
  done
  return 1
}

select_localconfig() {
  local root="$1" file
  local -a configs=() matches=()
  while IFS= read -r -d '' file; do
    configs+=("$file")
    grep -Eq '^[[:space:]]*"359320"[[:space:]]*$' "$file" && matches+=("$file")
  done < <(find "$root/userdata" -mindepth 3 -maxdepth 3 -type f -path '*/config/localconfig.vdf' -print0 2>/dev/null)
  if (( ${#matches[@]} )); then ls -1t -- "${matches[@]}" | head -n1; return 0; fi
  if (( ${#configs[@]} )); then ls -1t -- "${configs[@]}" | head -n1; return 0; fi
  return 1
}

extract_launch_options() {
  local file="$1"
  awk -v appid="$ELITE_APP_ID" '
    function bd(s, i,c,d,q,e){d=0;q=0;e=0;for(i=1;i<=length(s);i++){c=substr(s,i,1);if(q){if(e){e=0;continue}if(c=="\\"){e=1;continue}if(c=="\"")q=0;continue}if(c=="\""){q=1;continue}if(c=="{")d++;else if(c=="}")d--}return d}
    BEGIN{p=0;a=0;dep=0}
    {l=$0;if(!a&&l~"^[[:space:]]*\"" appid "\"[[:space:]]*$"){p=1;next}if(p){if(l~/^[[:space:]]*\{[[:space:]]*$/){a=1;dep=1;p=0;next}if(l!~/^[[:space:]]*$/)p=0}if(a){if(dep==1&&l~/^[[:space:]]*"LaunchOptions"[[:space:]]*"/){v=l;sub(/^[[:space:]]*"LaunchOptions"[[:space:]]*"/,"",v);sub(/"[[:space:]]*$/,"",v);print v;exit}dep+=bd(l);if(dep<=0)exit}}
  ' "$file"
}

patch_launch_options() {
  local file="$1" replacement="$2" out="$3"
  JACOB_REPLACEMENT="$replacement" awk -v appid="$ELITE_APP_ID" '
    function ws(s){match(s,/^[[:space:]]*/);return substr(s,1,RLENGTH)}
    function bd(s, i,c,d,q,e){d=0;q=0;e=0;for(i=1;i<=length(s);i++){c=substr(s,i,1);if(q){if(e){e=0;continue}if(c=="\\"){e=1;continue}if(c=="\"")q=0;continue}if(c=="\""){q=1;continue}if(c=="{")d++;else if(c=="}")d--}return d}
    BEGIN{r=ENVIRON["JACOB_REPLACEMENT"];p=0;a=0;dep=0;fa=0;rep=0;ind=""}
    {
      l=$0
      if(!a&&l~"^[[:space:]]*\"" appid "\"[[:space:]]*$"){p=1;fa=1;print l;next}
      if(p){print l;if(l~/^[[:space:]]*\{[[:space:]]*$/){a=1;dep=1;ind=ws(l)"\t";p=0;next}if(l!~/^[[:space:]]*$/)p=0;next}
      if(a){d=bd(l);if(dep==1&&l~/^[[:space:]]*"LaunchOptions"[[:space:]]*"/){printf "%s\"LaunchOptions\"\t\t\"%s\"\n",ws(l),r;rep=1}else if(dep==1&&d<0){if(!rep){printf "%s\"LaunchOptions\"\t\t\"%s\"\n",ind,r;rep=1}print l}else print l;dep+=d;if(dep<=0)a=0;next}
      print l
    }
    END{if(!fa)exit 42;if(!rep)exit 43}
  ' "$file" > "$out"
}

cat > "$LAUNCHER" <<'LAUNCH'
#!/usr/bin/env bash
set -u

JACOB_BIN="$HOME/.local/share/JACoB/JACoB"
JACOB_PID=""
JACOB_OWNED=0
GAME_PID=""

jacob_healthy() {
  command -v curl >/dev/null 2>&1 && curl -fsS --max-time 0.5 http://127.0.0.1:6626/api/health >/dev/null 2>&1
}

start_jacob() {
  if jacob_healthy; then
    return 0
  fi
  if [[ ! -x "$JACOB_BIN" ]]; then
    return 0
  fi
  JACOB_TESSERACT="$HOME/.local/share/JACoB/ocr/tesseract/AppRun" JACOB_GAMESCOPE_CAPTURE_HELPER="$HOME/.local/share/JACoB/jacob-gamescope-stream" JACOB_STEAM_APP_ID=359320 "$JACOB_BIN" >/dev/null 2>&1 &
  JACOB_PID=$!
  JACOB_OWNED=1
}

cleanup() {
  if [[ "$JACOB_OWNED" == "1" && -n "${JACOB_PID:-}" ]] && kill -0 "$JACOB_PID" 2>/dev/null; then
    kill "$JACOB_PID" 2>/dev/null || true
    wait "$JACOB_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

# Keep Elite as Steam/Gamescope's primary launch. JACoB starts headlessly just
# after the game chain begins, so no browser window can steal Gaming Mode focus.
"$@" &
GAME_PID=$!
sleep 0.75
start_jacob

while kill -0 "$GAME_PID" 2>/dev/null; do
  if ! jacob_healthy; then
    if [[ -z "${JACOB_PID:-}" ]] || ! kill -0 "$JACOB_PID" 2>/dev/null; then
      start_jacob
    fi
  fi
  sleep 2
done

wait "$GAME_PID"
status=$?
exit $status
LAUNCH
chmod 0755 "$LAUNCHER"

STEAM_ROOT="$(find_steam_root)" || { echo "Steam userdata not found; will retry later."; exit 0; }
LOCALCONFIG="$(select_localconfig "$STEAM_ROOT")" || { echo "localconfig.vdf not found; will retry later."; exit 0; }

CURRENT="$(extract_launch_options "$LOCALCONFIG" || true)"
LEGACY=0
if [[ "$CURRENT" == *"run-elite-with-jacob.sh"* ]]; then
  LEGACY=1
  echo "Legacy JACoB Steam wrapper detected; migrating launch options."
  if [[ "$CURRENT" == *"%command%"* ]]; then
    suffix="${CURRENT#*%command%}"
    CURRENT="%command%$suffix"
  else
    CURRENT="%command%"
  fi
fi

# The launcher file above is refreshed on every run. If launch options already
# point directly at it and no legacy wrapper surrounds it, no VDF edit is needed.
if [[ "$CURRENT" == *"$LAUNCHER"* && "$LEGACY" == "0" ]]; then
  printf '%s\n' "installed" > "$HOOK_STAMP"
  echo "Steam hook already current."
  exit 0
fi

# Avoid Steam overwriting localconfig.vdf after we edit it.
echo "Closing Steam before editing localconfig.vdf..."
flatpak-spawn --host sh -lc 'steam -shutdown >/dev/null 2>&1 || true' || true
for _ in {1..60}; do
  if ! flatpak-spawn --host pgrep -x steam >/dev/null 2>&1; then break; fi
  sleep 0.5
done

LOCALCONFIG="$(select_localconfig "$STEAM_ROOT")" || { echo "localconfig missing after Steam shutdown"; exit 1; }
CURRENT="$(extract_launch_options "$LOCALCONFIG" || true)"
if [[ "$CURRENT" == *"run-elite-with-jacob.sh"* ]]; then
  if [[ "$CURRENT" == *"%command%"* ]]; then
    suffix="${CURRENT#*%command%}"
    CURRENT="%command%$suffix"
  else
    CURRENT="%command%"
  fi
fi

if [[ "$CURRENT" == *"$LAUNCHER"* ]]; then
  NEW="$CURRENT"
elif [[ "$CURRENT" == *"%command%"* ]]; then
  NEW="${CURRENT/\%command%/$LAUNCHER %command%}"
elif [[ -n "$CURRENT" ]]; then
  NEW="$LAUNCHER %command% $CURRENT"
else
  NEW="$LAUNCHER %command%"
fi

BACKUP="$LOCALCONFIG.jacob-backup-$(date +%Y%m%d-%H%M%S)"
cp -p "$LOCALCONFIG" "$BACKUP"
TMP="$LOCALCONFIG.jacob-new-$$"
set +e
patch_launch_options "$LOCALCONFIG" "$NEW" "$TMP"
rc=$?
set -e
if [[ $rc -ne 0 ]]; then
  rm -f "$TMP"
  echo "Could not patch Elite launch options (status $rc). Backup: $BACKUP"
  flatpak-spawn --host sh -lc 'nohup steam -silent >/dev/null 2>&1 &' || true
  exit 1
fi
mv -f "$TMP" "$LOCALCONFIG"
printf '%s\n' "installed" > "$HOOK_STAMP"
echo "Steam hook installed. Backup: $BACKUP"
flatpak-spawn --host sh -lc 'nohup steam -silent >/dev/null 2>&1 &' || true
