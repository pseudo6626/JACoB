#!/usr/bin/env bash
set -Eeuo pipefail

HOST_HOME="$(flatpak-spawn --host sh -lc 'printf %s "$HOME"')"
[[ -n "$HOST_HOME" ]] || { echo "Could not resolve the Steam Deck home directory." >&2; exit 1; }
HOST_UID="$(flatpak-spawn --host id -u)"
HOST_RUNTIME="/run/user/$HOST_UID"
HOST_DIR="$HOST_HOME/.local/share/JACoB"
HOST_BIN="$HOST_DIR/JACoB"
HOST_HELPER="$HOST_DIR/jacob-gamescope-stream"
HOST_VK_DIR="$HOST_DIR/vulkan-hud"
HOST_VK_LIB="$HOST_VK_DIR/libVK_LAYER_JACOB_hud.so"
HOST_VK_VERT="$HOST_VK_DIR/overlay.vert.spv"
HOST_VK_FRAG="$HOST_VK_DIR/overlay.frag.spv"
HOST_VK_ENABLED="$HOST_VK_DIR/enabled"
VK_MANIFEST_DIR="$HOST_HOME/.local/share/vulkan/implicit_layer.d"
VK_MANIFEST="$VK_MANIFEST_DIR/VK_LAYER_JACOB_hud.json"
OCR_DIR="$HOST_DIR/ocr/tesseract"
INSTALL_ID_FILE="$HOST_DIR/.flatpak-install-id"
PACKAGED_VERSION="$(cat /app/share/jacob/VERSION 2>/dev/null || echo unknown)"
PACKAGED_BIN_HASH="$(sha256sum /app/libexec/JACoB | awk '{print $1}')"
PACKAGED_HELPER_HASH="$(sha256sum /app/libexec/jacob-gamescope-stream | awk '{print $1}')"
PACKAGED_VK_HASH="$(sha256sum /app/share/jacob/vulkan-hud/libVK_LAYER_JACOB_hud.so /app/share/jacob/vulkan-hud/overlay.vert.spv /app/share/jacob/vulkan-hud/overlay.frag.spv | sha256sum | awk '{print $1}')"
PACKAGED_OCR_HASH="$(sha256sum /app/libexec/tesseract/AppRun | awk '{print $1}')"
INSTALL_ID="v10:${PACKAGED_VERSION}:${PACKAGED_BIN_HASH}:${PACKAGED_HELPER_HASH}:${PACKAGED_VK_HASH}:${PACKAGED_OCR_HASH}"
LOG_DIR="$HOST_HOME/.config/JACoB"
LOG_FILE="$LOG_DIR/deck-install.log"

mkdir -p "$LOG_DIR"

log_install() {
  printf '[%s] %s\n' "$(date -Is)" "$*" >> "$LOG_FILE"
}

stop_old_host_jacob() {
  flatpak-spawn --host sh -lc '
    target="$HOME/.local/share/JACoB/JACoB"
    found=0
    for p in /proc/[0-9]*; do
      exe="$(readlink -f "$p/exe" 2>/dev/null || true)"
      if [[ "$exe" == "$target" ]]; then
        found=1
        kill -TERM "${p##*/}" 2>/dev/null || true
      fi
    done
    if [[ "$found" == "1" ]]; then
      for _ in $(seq 1 40); do
        live=0
        for p in /proc/[0-9]*; do
          exe="$(readlink -f "$p/exe" 2>/dev/null || true)"
          [[ "$exe" == "$target" ]] && { live=1; break; }
        done
        [[ "$live" == "0" ]] && exit 0
        sleep 0.1
      done
      for p in /proc/[0-9]*; do
        exe="$(readlink -f "$p/exe" 2>/dev/null || true)"
        [[ "$exe" == "$target" ]] && kill -KILL "${p##*/}" 2>/dev/null || true
      done
    fi
  ' >/dev/null 2>&1 || true
}

remove_legacy_decky_hud() {
  local target="$HOST_HOME/homebrew/plugins/JACoB-HUD"
  [[ -e "$target" ]] || return 0
  rm -rf "$target" 2>/dev/null || true
  if [[ -e "$target" ]]; then
    log_install "Legacy Decky HUD is root-owned; requesting privileged removal."
    flatpak-spawn --host pkexec /usr/bin/rm -rf "$target"
  fi
  [[ ! -e "$target" ]] || {
    echo "Could not remove legacy Decky plugin at $target" >&2
    return 1
  }
}

clean_managed_payload() {
  log_install "Managed payload changed; performing clean JACoB Steam Deck reinstall. User data in ~/.config/JACoB is preserved."
  stop_old_host_jacob

  # ~/.local/share/JACoB is installer-managed on Steam Deck. User tabs/config/pairing
  # live under ~/.config/JACoB and are intentionally untouched.
  rm -rf "$HOST_DIR"
  mkdir -p "$HOST_DIR"

  rm -f "$VK_MANIFEST"
  remove_legacy_decky_hud

  # Remove old known wrappers/staging left by earlier Deck installers.
  rm -f "$HOST_HOME/.local/bin/run-elite-with-jacob.sh" 2>/dev/null || true
  rm -f "$HOST_HOME/.local/bin/jacob-elite-launch" 2>/dev/null || true
}

CURRENT_INSTALL_ID="$(cat "$INSTALL_ID_FILE" 2>/dev/null || true)"
if [[ "$CURRENT_INSTALL_ID" != "$INSTALL_ID" ]]; then
  clean_managed_payload
else
  mkdir -p "$HOST_DIR"
fi

install -m 0755 /app/libexec/JACoB "$HOST_BIN.new"
mv -f "$HOST_BIN.new" "$HOST_BIN"
install -m 0755 /app/libexec/jacob-gamescope-stream "$HOST_HELPER.new"
mv -f "$HOST_HELPER.new" "$HOST_HELPER"

rm -rf "$HOST_VK_DIR.new"
mkdir -p "$HOST_VK_DIR.new"
install -m 0755 /app/share/jacob/vulkan-hud/libVK_LAYER_JACOB_hud.so "$HOST_VK_DIR.new/libVK_LAYER_JACOB_hud.so"
install -m 0644 /app/share/jacob/vulkan-hud/overlay.vert.spv "$HOST_VK_DIR.new/overlay.vert.spv"
install -m 0644 /app/share/jacob/vulkan-hud/overlay.frag.spv "$HOST_VK_DIR.new/overlay.frag.spv"
printf '%s\n' "v10" > "$HOST_VK_DIR.new/enabled"
rm -rf "$HOST_VK_DIR"
mv "$HOST_VK_DIR.new" "$HOST_VK_DIR"

mkdir -p "$VK_MANIFEST_DIR"
cat > "$VK_MANIFEST.new" <<EOF_MANIFEST
{
  "file_format_version": "1.1.0",
  "layer": {
    "name": "VK_LAYER_JACOB_hud",
    "type": "GLOBAL",
    "library_path": "$HOST_VK_LIB",
    "api_version": "1.3.0",
    "implementation_version": "10",
    "description": "JACoB in-process Steam Deck HUD and clean Vision capture",
    "enable_environment": { "JACOB_VK_HUD": "1" },
    "disable_environment": { "JACOB_VK_HUD_DISABLE": "1" }
  }
}
EOF_MANIFEST
mv -f "$VK_MANIFEST.new" "$VK_MANIFEST"

rm -rf "$OCR_DIR.new"
mkdir -p "$OCR_DIR.new"
cp -a /app/libexec/tesseract/. "$OCR_DIR.new/"
chmod +x "$OCR_DIR.new/AppRun"
rm -rf "$OCR_DIR"
mv "$OCR_DIR.new" "$OCR_DIR"

# Old Decky HUD builds must not remain active beside the Vulkan renderer.
remove_legacy_decky_hud
rm -rf "$HOST_DIR/decky"

printf '%s\n' "$INSTALL_ID" > "$INSTALL_ID_FILE"
printf '%s\n' "$PACKAGED_VERSION" > "$HOST_DIR/.flatpak-payload-version"
log_install "Installed JACoB ${PACKAGED_VERSION} v10 managed payload. bin=${PACKAGED_BIN_HASH} vk=${PACKAGED_VK_HASH}"

if [[ "${1:-}" != "--service-only" ]]; then
  if ! flatpak-spawn --host sh -lc 'grep -Fq "JACoB Steam Deck input access" /etc/udev/rules.d/70-jacob-input.rules 2>/dev/null'; then
    log_install "Requesting one-time input-device permission setup."
    if flatpak-spawn --host pkexec sh -c 'cat > /etc/udev/rules.d/70-jacob-input.rules <<"EOF_RULES"
# JACoB Steam Deck input access
KERNEL=="uinput", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", MODE="0660", TAG+="uaccess"
EOF_RULES
udevadm control --reload-rules
udevadm trigger --subsystem-match=input --action=change
'; then
      log_install "Input-device permissions installed."
    else
      log_install "WARNING: input-device permission setup was declined or failed; Action Recorder may remain unavailable."
    fi
  fi

  JACOB_HOST_HOME="$HOST_HOME" /app/bin/jacob-steam-integrate || true
fi

if [[ "${1:-}" == "--service-only" ]]; then
  exit 0
fi

# Desktop Mode: run the host-native core without letting it launch xdg-open itself.
# We launch the browser separately with the real desktop D-Bus/runtime environment.
stop_old_host_jacob
flatpak-spawn --host sh -lc '
  export JACOB_OPEN_BROWSER=0
  export JACOB_TESSERACT="$HOME/.local/share/JACoB/ocr/tesseract/AppRun"
  export JACOB_GAMESCOPE_CAPTURE_HELPER="$HOME/.local/share/JACoB/jacob-gamescope-stream"
  export JACOB_VK_RUNTIME_DIR="$HOME/.local/share/JACoB/vulkan-runtime"
  exec "$HOME/.local/share/JACoB/JACoB"
' >/dev/null 2>&1 &
HOST_JACOB_SPAWN=$!

ready=0
for _ in $(seq 1 100); do
  if curl -fsS --max-time 0.25 http://127.0.0.1:6626/api/health >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 0.1
done

if [[ "$ready" == "1" ]]; then
  flatpak-spawn --host sh -lc '
    uid="$(id -u)"
    export XDG_RUNTIME_DIR="/run/user/$uid"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    if [[ -S "$XDG_RUNTIME_DIR/wayland-0" ]]; then
      export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
    fi
    export DISPLAY="${DISPLAY:-:0}"
    if command -v xdg-open >/dev/null 2>&1; then
      nohup xdg-open http://127.0.0.1:6626/ >/dev/null 2>&1 &
    elif command -v kde-open5 >/dev/null 2>&1; then
      nohup kde-open5 http://127.0.0.1:6626/ >/dev/null 2>&1 &
    fi
  ' >/dev/null 2>&1 || true
  log_install "Desktop Mode JACoB started and browser-open request issued."
else
  log_install "WARNING: Desktop Mode JACoB did not become healthy before browser launch timeout."
fi

wait "$HOST_JACOB_SPAWN" || true
