#!/usr/bin/env bash
set -Eeuo pipefail

HOST_HOME="$(flatpak-spawn --host sh -lc 'printf %s "$HOME"')"
[[ -n "$HOST_HOME" ]] || { echo "Could not resolve the Steam Deck home directory." >&2; exit 1; }
HOST_DIR="$HOST_HOME/.local/share/JACoB"
HOST_BIN="$HOST_DIR/JACoB"
STAMP="$HOST_DIR/.flatpak-payload-version"
HASH_STAMP="$HOST_DIR/.flatpak-payload-sha256"
OCR_DIR="$HOST_DIR/ocr/tesseract"
OCR_STAMP="$HOST_DIR/.flatpak-ocr-sha256"
PACKAGED_VERSION="$(cat /app/share/jacob/VERSION 2>/dev/null || echo unknown)"
PACKAGED_HASH="$(sha256sum /app/libexec/JACoB | awk '{print $1}')"
PACKAGED_HELPER_HASH="$(sha256sum /app/libexec/jacob-gamescope-stream | awk '{print $1}')"
HOST_HELPER="$HOST_DIR/jacob-gamescope-stream"
HOST_DECKY_DIR="$HOST_DIR/decky/JACoB-HUD"
DECKY_HASH_STAMP="$HOST_DIR/.decky-hud-payload-sha256"
DECKY_RELOAD_STAMP="$HOST_DIR/.decky-hud-loaded-sha256"
PACKAGED_DECKY_HASH="$(find /app/share/jacob/decky/JACoB-HUD -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')"
PACKAGED_OCR_HASH="$(sha256sum /app/libexec/tesseract/AppRun | awk '{print $1}')"
LOG_DIR="$HOST_HOME/.config/JACoB"
LOG_FILE="$LOG_DIR/deck-install.log"

mkdir -p "$HOST_DIR" "$LOG_DIR"

HOST_HASH=""
if [[ -f "$HOST_BIN" ]]; then
  HOST_HASH="$(sha256sum "$HOST_BIN" 2>/dev/null | awk '{print $1}' || true)"
fi

if [[ ! -x "$HOST_BIN" || "$HOST_HASH" != "$PACKAGED_HASH" ]]; then
  install -m 0755 /app/libexec/JACoB "$HOST_BIN.new"
  mv -f "$HOST_BIN.new" "$HOST_BIN"
  HOST_HASH="$PACKAGED_HASH"
  printf '[%s] Installed native JACoB payload version=%s sha256=%s\n' "$(date -Is)" "$PACKAGED_VERSION" "$PACKAGED_HASH" >> "$LOG_FILE"
else
  printf '[%s] Native JACoB payload already current version=%s sha256=%s\n' "$(date -Is)" "$PACKAGED_VERSION" "$PACKAGED_HASH" >> "$LOG_FILE"
fi
printf '%s\n' "$PACKAGED_VERSION" > "$STAMP"
printf '%s\n' "$PACKAGED_HASH" > "$HASH_STAMP"

HOST_HELPER_HASH="$(sha256sum "$HOST_HELPER" 2>/dev/null | awk '{print $1}' || true)"
if [[ ! -x "$HOST_HELPER" || "$HOST_HELPER_HASH" != "$PACKAGED_HELPER_HASH" ]]; then
  install -m 0755 /app/libexec/jacob-gamescope-stream "$HOST_HELPER.new"
  mv -f "$HOST_HELPER.new" "$HOST_HELPER"
  printf '[%s] Installed Gamescope PipeWire helper sha256=%s\n' "$(date -Is)" "$PACKAGED_HELPER_HASH" >> "$LOG_FILE"
fi

INSTALLED_DECKY_HASH="$(cat "$DECKY_HASH_STAMP" 2>/dev/null || true)"
if [[ ! -d "$HOST_DECKY_DIR" || "$INSTALLED_DECKY_HASH" != "$PACKAGED_DECKY_HASH" ]]; then
  rm -rf "$HOST_DECKY_DIR.new"
  mkdir -p "$(dirname "$HOST_DECKY_DIR")" "$HOST_DECKY_DIR.new"
  cp -a /app/share/jacob/decky/JACoB-HUD/. "$HOST_DECKY_DIR.new/"
  rm -rf "$HOST_DECKY_DIR"
  mv "$HOST_DECKY_DIR.new" "$HOST_DECKY_DIR"
  printf '%s\n' "$PACKAGED_DECKY_HASH" > "$DECKY_HASH_STAMP"
fi

if [[ -d "$HOST_HOME/homebrew/plugins" ]]; then
  DECKY_TARGET="$HOST_HOME/homebrew/plugins/JACoB-HUD"
  DECKY_NEW="$HOST_HOME/homebrew/plugins/.JACoB-HUD.new"

  CURRENT_TARGET_HASH=""
  if [[ -d "$DECKY_TARGET" ]]; then
    CURRENT_TARGET_HASH="$(find "$DECKY_TARGET" -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}' || true)"
  fi

  if [[ "$CURRENT_TARGET_HASH" != "$PACKAGED_DECKY_HASH" ]]; then
    rm -rf "$DECKY_NEW"
    cp -a "$HOST_DECKY_DIR" "$DECKY_NEW"
    rm -rf "$DECKY_TARGET"
    mv "$DECKY_NEW" "$DECKY_TARGET"
    printf '[%s] Installed/updated JACoB Decky HUD bridge payload=%s.\n' "$(date -Is)" "$PACKAGED_DECKY_HASH" >> "$LOG_FILE"
  fi

  LOADED_DECKY_HASH="$(cat "$DECKY_RELOAD_STAMP" 2>/dev/null || true)"
  if [[ "$LOADED_DECKY_HASH" != "$PACKAGED_DECKY_HASH" && "${1:-}" != "--service-only" ]]; then
    if flatpak-spawn --host systemctl is-active --quiet plugin_loader.service >/dev/null 2>&1; then
      printf '[%s] Requesting Decky reload so the JACoB HUD renderer becomes active.\n' "$(date -Is)" >> "$LOG_FILE"
      if flatpak-spawn --host pkexec systemctl restart plugin_loader.service; then
        printf '%s\n' "$PACKAGED_DECKY_HASH" > "$DECKY_RELOAD_STAMP"
        printf '[%s] Decky plugin loader restarted; JACoB HUD renderer should load in this Steam session.\n' "$(date -Is)" >> "$LOG_FILE"
      else
        printf '[%s] WARNING: Decky reload was declined/failed. Rebooting the Deck will load the installed JACoB HUD bridge.\n' "$(date -Is)" >> "$LOG_FILE"
      fi
    else
      printf '[%s] Decky plugin_loader.service is not active. Reboot or start Decky to load the JACoB HUD bridge.\n' "$(date -Is)" >> "$LOG_FILE"
    fi
  fi
else
  printf '[%s] Decky Loader not detected; HUD bridge retained at %s.\n' "$(date -Is)" "$HOST_DECKY_DIR" >> "$LOG_FILE"

  if [[ "${1:-}" != "--service-only" ]]; then
    DECKY_GUIDE_STAMP="$HOST_DIR/.decky-install-guidance-shown"
    DECKY_URL="https://github.com/SteamDeckHomebrew/decky-loader"

    if [[ ! -f "$DECKY_GUIDE_STAMP" ]]; then
      printf '[%s] Decky is required for JACoB in-game HUD rendering. Opening official installation guidance.\n' "$(date -Is)" >> "$LOG_FILE"

      if flatpak-spawn --host sh -lc 'command -v kdialog >/dev/null 2>&1'; then
        if flatpak-spawn --host kdialog           --title "JACoB Steam Deck Setup"           --yesno "JACoB is installed, but Decky Loader is required for JACoB HUD overlays in Gaming Mode. Open the official Decky installation page now?"; then
          flatpak-spawn --host xdg-open "$DECKY_URL" >/dev/null 2>&1 || true
        fi
      else
        flatpak-spawn --host xdg-open "$DECKY_URL" >/dev/null 2>&1 || true
      fi

      printf '%s\n' "$(date -Is)" > "$DECKY_GUIDE_STAMP"
    fi
  fi
fi

HOST_OCR_HASH="$(cat "$OCR_STAMP" 2>/dev/null || true)"
if [[ ! -x "$OCR_DIR/AppRun" || "$HOST_OCR_HASH" != "$PACKAGED_OCR_HASH" ]]; then
  rm -rf "$OCR_DIR.new"
  mkdir -p "$OCR_DIR.new"
  cp -a /app/libexec/tesseract/. "$OCR_DIR.new/"
  rm -rf "$OCR_DIR"
  mv "$OCR_DIR.new" "$OCR_DIR"
  chmod +x "$OCR_DIR/AppRun"
  printf '%s\n' "$PACKAGED_OCR_HASH" > "$OCR_STAMP"
  printf '[%s] Installed bundled OCR runtime sha256=%s\n' "$(date -Is)" "$PACKAGED_OCR_HASH" >> "$LOG_FILE"
fi

if [[ "${1:-}" != "--service-only" ]]; then
  RULE_MARKER='JACoB Steam Deck input access'
  if ! flatpak-spawn --host sh -lc 'grep -Fq "JACoB Steam Deck input access" /etc/udev/rules.d/70-jacob-input.rules 2>/dev/null'; then
    printf '[%s] Requesting one-time input-device permission setup.\n' "$(date -Is)" >> "$LOG_FILE"
    if flatpak-spawn --host pkexec sh -c 'cat > /etc/udev/rules.d/70-jacob-input.rules <<"EOF"
# JACoB Steam Deck input access
KERNEL=="uinput", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", MODE="0660", TAG+="uaccess"
EOF
udevadm control --reload-rules
udevadm trigger --subsystem-match=input --action=change
'; then
      printf '[%s] Input-device permissions installed.\n' "$(date -Is)" >> "$LOG_FILE"
    else
      printf '[%s] WARNING: input-device permission setup was declined or failed; Action Recorder may remain unavailable.\n' "$(date -Is)" >> "$LOG_FILE"
    fi
  fi
  JACOB_HOST_HOME="$HOST_HOME" /app/bin/jacob-steam-integrate || true
fi

exec flatpak-spawn --host sh -lc 'export JACOB_OPEN_BROWSER=1; export JACOB_TESSERACT="$HOME/.local/share/JACoB/ocr/tesseract/AppRun"; export JACOB_GAMESCOPE_CAPTURE_HELPER="$HOME/.local/share/JACoB/jacob-gamescope-stream"; exec "$HOME/.local/share/JACoB/JACoB"'
